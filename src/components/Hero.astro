---
import Arrow from './Arrow.astro';
import { heroImages, officialContact } from '../data/assets';
---

<section class="hero" aria-labelledby="hero-title">
  <picture class="hero-backdrop" aria-hidden="true">
    <source
      media="(max-width: 47.99rem)"
      srcset={heroImages.mobileSrcset}
      sizes="100vw"
      width="768"
      height="1024"
    />
    <img
      src={heroImages.desktop}
      srcset={heroImages.desktopSrcset}
      sizes="100vw"
      width="1920"
      height="1280"
      alt=""
      fetchpriority="high"
      decoding="async"
    />
  </picture>
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="container hero-inner">
    <div class="hero-content">
      <p class="hero-kicker">Binding Identity Technology</p>
      <h1 id="hero-title">Check-in digital en menos de 20 segundos.</h1>
      <p class="lead">
        Binding Software digitaliza la llegada a tu hotel con Binding Identity.
        Menos tareas de registro, más tiempo para tus huéspedes.
      </p>
      <div class="hero-actions">
        <a href={officialContact} class="button">
          Solicitar información <Arrow />
        </a>
      </div>
    </div>
  </div>
</section>
<style>
  .hero {
    display: grid;
    position: relative;
    isolation: isolate;
    min-block-size: max(0px, calc(100vh - var(--site-header-height)));
    min-block-size: max(0px, calc(100svh - var(--site-header-height)));
    background: var(--color-dark);
    color: var(--color-on-dark);
  }
  .hero-backdrop,
  .hero-shade {
    position: absolute;
    inset: 0;
  }
  .hero-backdrop {
    z-index: -2;
  }
  .hero-backdrop img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .hero-shade {
    z-index: -1;
    background: var(--hero-overlay-mobile);
  }
  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: start;
    padding-block: var(--space-4) max(var(--space-4), env(safe-area-inset-bottom));
  }
  .hero-content {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    max-inline-size: min(100%, 46rem);
    margin-block: auto;
    padding-block: clamp(var(--space-3), 4svh, var(--space-8));
    overflow-wrap: anywhere;
  }
  .hero-kicker {
    color: var(--color-accent);
    font-size: var(--font-caption);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  h1 {
    max-inline-size: 100%;
    font-size: clamp(2rem, 8vw, var(--font-display));
    text-wrap: balance;
  }
  .lead {
    max-inline-size: 48ch;
    /* Iguala la altura de x de la fuente de reserva a la de Inter. */
    font-size-adjust: 0.546;
  }
  .hero-actions {
    margin-block-start: var(--space-2);
  }
  @media (min-width: 60rem) {
    .hero-shade {
      background: var(--hero-overlay-desktop);
    }
    .hero-content {
      max-inline-size: min(64%, 46rem);
    }
    h1 {
      font-size-adjust: 0.546;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    h1,
    .lead,
    .hero-actions {
      animation: hero-arrive var(--motion-entry-duration) var(--ease-out)
        backwards;
    }
    .lead {
      animation-delay: var(--motion-stagger);
    }
    .hero-actions {
      animation-delay: calc(var(--motion-stagger) * 2);
    }
    .hero-content:focus-within > * {
      transform: none !important;
    }
  }
  @keyframes hero-arrive {
    from {
      transform: translateY(var(--motion-entry-distance));
    }
    to {
      transform: none;
    }
  }
</style>
