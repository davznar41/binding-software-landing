---
import Arrow from './Arrow.astro';
import { heroImages, officialContact } from '../data/assets';
---

<section class="hero" aria-labelledby="hero-title">
  <picture class="hero-backdrop" aria-hidden="true">
    <source
      media="(max-width: 47.99rem)"
      srcset={heroImages.mobileSrcset}
      sizes="100vw"
      width="768"
      height="1024"
    />
    <img
      src={heroImages.desktop}
      srcset={heroImages.desktopSrcset}
      sizes="100vw"
      width="1920"
      height="1280"
      alt=""
      fetchpriority="high"
      decoding="async"
    />
  </picture>
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="container hero-content">
    <p class="hero-kicker">Binding Identity Technology</p>
    <h1 id="hero-title">
      Check-in digital en <span>menos de 20 segundos.</span>
    </h1>
    <p class="lead">
      Binding Software digitaliza la llegada a tu hotel con Binding Identity.
      Menos tareas de registro, más tiempo para tus huéspedes.
    </p>
    <div class="hero-actions">
      <a href={officialContact} class="button">
        Solicitar información <Arrow />
      </a>
    </div>
  </div>
  <div class="container hero-bottom">
    <span>I+D+i aplicada a la gestión hotelera.</span>
  </div>
</section>
<style>
  .hero {
    position: relative;
    isolation: isolate;
    background: var(--color-dark);
    color: var(--color-on-dark);
  }
  .hero-backdrop,
  .hero-shade {
    position: absolute;
    inset: 0;
  }
  .hero-backdrop {
    z-index: -2;
  }
  .hero-backdrop img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 55%;
  }
  .hero-shade {
    z-index: -1;
    background: var(--hero-overlay-desktop);
  }
  .hero-content {
    padding-block: clamp(var(--space-12), 7vw, var(--space-24));
  }
  .hero-kicker {
    margin-bottom: var(--space-6);
    color: var(--color-accent);
    font-size: var(--font-caption);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  h1 {
    max-width: 17ch;
  }
  h1 span {
    color: var(--color-accent);
  }
  .lead {
    max-width: 51ch;
    margin-top: var(--space-6);
    color: var(--color-on-dark-muted);
  }
  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-8);
    margin-top: var(--space-8);
  }
  .hero-bottom {
    display: flex;
    border-top: var(--border-width) solid var(--color-dark-line);
    padding-block: var(--space-6);
    color: var(--color-on-dark-muted);
    font-size: var(--font-caption);
  }
  @media (min-width: 48rem) {
    h1 {
      max-width: min(17ch, 64%);
    }
    .lead {
      max-width: min(51ch, 64%);
    }
  }
  @media (max-width: 47.99rem) {
    .hero-backdrop img {
      object-position: 52% 50%;
    }
    .hero-shade {
      background: var(--hero-overlay-mobile);
    }
  }
  @media (min-width: 64rem) {
    .hero-content {
      padding-block: calc(
        clamp(var(--space-12), 7vw, var(--space-24)) + var(--space-2)
      );
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    h1,
    .lead,
    .hero-actions {
      animation: hero-arrive var(--motion-entry-duration) var(--ease-out)
        backwards;
    }
    .lead {
      animation-delay: var(--motion-stagger);
    }
    .hero-actions {
      animation-delay: calc(var(--motion-stagger) * 2);
    }
    .hero-content:focus-within > * {
      transform: none !important;
    }
  }
  @keyframes hero-arrive {
    from {
      transform: translateY(var(--motion-entry-distance));
    }
    to {
      transform: none;
    }
  }
</style>
