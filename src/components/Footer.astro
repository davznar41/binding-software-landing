---
const isAccessibility =
  Astro.url.pathname.replace(/\/$/, '') === '/accesibilidad';
---

<footer id="contacto" class="site-footer">
  <div class="container footer-inner">
    <div>
      <p class="footer-brand">
        Binding<span> Software</span>
      </p>
      <p class="footer-description">Tecnología que conecta la hospitalidad.</p>
    </div>
    <nav aria-label="Pie de página">
      <a href="/" aria-current={!isAccessibility ? 'page' : undefined}>
        Inicio
      </a>
      <a
        href="/accesibilidad/"
        aria-current={isAccessibility ? 'page' : undefined}
      >
        Accesibilidad
      </a>
      <a href="https://bindingsoftware.com/contacto/">
        Contacto <span aria-hidden="true">↗</span>
      </a>
    </nav>
  </div>
  <div class="container footer-note">
    <p>Binding Software · Tecnología para la gestión hotelera</p>
  </div>
</footer>
<style>
  .site-footer {
    background: var(--color-dark);
    color: var(--color-on-dark);
    padding-top: var(--space-12);
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-8);
    padding-bottom: var(--space-8);
  }
  .footer-brand {
    font-size: var(--font-heading-small);
    font-weight: 650;
    letter-spacing: -0.025em;
  }
  .footer-brand span {
    font-weight: 400;
  }
  .footer-description {
    margin-top: var(--space-2);
    color: var(--color-on-dark-muted);
    font-size: var(--font-small);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    align-items: center;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-on-dark);
    min-height: var(--target-size);
    font-size: var(--font-small);
  }
  nav a:hover {
    color: var(--color-accent);
  }
  nav a[aria-current] {
    text-decoration-thickness: 2px;
  }
  .footer-note {
    border-top: var(--border-width) solid var(--color-dark-line);
    padding-block: var(--space-6);
    color: var(--color-on-dark-muted);
    font-size: var(--font-caption);
  }
</style>
