---
import Arrow from './Arrow.astro';
import { officialContact } from '../data/assets';
const source = 'https://bindingsoftware.com/por-que-binding/';
const savings = [
  {
    category: 'Recepción',
    from: '18.000',
    to: '25.000',
    title: 'Ahorro en costes operativos',
    text: '600 min/día liberados en recepción con una ocupación del 75 %.',
  },
  {
    category: 'Paperless',
    from: '10.000',
    to: '15.000',
    title: 'Ahorro en papel',
    text: 'Proceso 100 % digital, sin papel ni archivo físico.',
  },
  {
    category: 'Stack único',
    from: '7.000',
    to: '12.000',
    title: 'Ahorro en herramientas de terceros',
    text: 'Firma, check-in online, pagos, SES y procesos conectados.',
  },
];
---

<section
  id="ventajas"
  class="section benefits"
  aria-labelledby="benefits-title"
>
  <div class="container">
    <div class="section-heading">
      <h2 id="benefits-title">Un impacto tangible en tu hotel</h2>
      <p>
        Menos tareas manuales en horas punta, más control operativo y más tiempo
        para atender al huésped.
      </p>
    </div>
    <p class="results-context editorial-context">
      Datos y afirmaciones publicados por Binding. Son un ejemplo de referencia,
      no una garantía de ahorro, retorno o cumplimiento para cualquier hotel:
      dependen de su configuración y operativa.{' '}
      <a href={source}>Consultar el contexto de los resultados</a>.
    </p>
    <ul class="operational-results" role="list">
      <li>
        <div class="result-metric">
          <p class="result-value">95 %</p>
          <h3>Menos tiempo de check-in</h3>
        </div>
        <p>Reducción del tiempo de registro publicada por Binding.</p>
      </li>
      <li>
        <div class="result-metric">
          <p class="result-value">&gt;600</p>
          <h3>Minutos al día para recepción</h3>
        </div>
        <p>Tiempo liberado para que el equipo atienda al huésped.</p>
      </li>
      <li>
        <blockquote class="result-metric" cite={source}>
          <p class="result-value">100 %</p>
          <h3>Legal y reportes SES</h3>
        </blockquote>
        <p>
          Afirmación publicada por Binding sobre su gestión de registros y
          reportes.
        </p>
      </li>
    </ul>
    <div class="economic-impact">
      <h3 id="economic-title">Impacto económico anual por hotel</h3>
      <p class="economic-intro editorial-context">
        Ejemplo publicado por Binding para un hotel de{' '}
        <strong>200 habitaciones y 75 % de ocupación</strong>. En este
        escenario, el retorno puede llegar en <strong>1–3 meses</strong>, entre
        ahorro operativo, papel y herramientas de terceros.
      </p>
      <ul class="economic-results" role="list">
        {savings.map((saving) => (
          <li>
            <h4>{saving.category}</h4>
            <p class="saving-amount">
              <span>{saving.from}</span>
              <span>–{saving.to} €</span>
            </p>
            <p class="saving-title">{saving.title}</p>
            <p>{saving.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<section class="section contact-band" aria-labelledby="contact-band-title">
  <div class="container contact-band-inner">
    <div>
      <h2 id="contact-band-title">Hablemos de la operativa de tu hotel</h2>
      <p>Cuéntanos cómo gestionas el check-in y qué procesos quieres conectar.</p>
    </div>
    <a class="button results-contact" href={officialContact}>
      Solicitar información <Arrow />
    </a>
  </div>
</section>
<style>
  ul {
    display: grid;
    gap: var(--space-6);
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .operational-results > li {
    padding-top: var(--space-4);
    border-top: var(--border-width) solid var(--color-line);
  }
  blockquote {
    margin: 0;
  }
  .result-metric {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: var(--space-4);
    align-items: center;
  }
  .result-value {
    color: var(--color-primary);
    font-size: 2.125rem;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: var(--tracking-heading);
    white-space: nowrap;
  }
  .operational-results h3 {
    font-size: var(--font-lead);
    line-height: 1.35;
  }
  li > p:not(.result-value):not(.saving-amount):not(.saving-title) {
    color: var(--color-muted);
    font-size: var(--font-small);
    margin-top: var(--space-2);
    max-width: 35ch;
  }
  .operational-results > li > p {
    margin-inline-start: calc(5.5rem + var(--space-4));
  }
  .economic-impact {
    margin-top: var(--space-12);
  }
  .economic-impact > h3 {
    font-size: var(--font-value);
  }
  .editorial-context {
    max-inline-size: 78ch;
    padding: var(--space-4) var(--space-6);
    border-inline-start: 3px solid var(--color-primary);
    background: var(--color-surface);
    color: var(--color-muted);
    font-size: var(--font-small);
  }
  .economic-intro {
    margin-block: var(--space-4) var(--space-6);
  }
  .economic-results {
    gap: var(--space-4);
  }
  .economic-results > li {
    min-width: 0;
    padding: 1.25rem;
    border: var(--border-width) solid var(--color-line);
    border-radius: var(--radius-panel);
    background: var(--color-surface);
  }
  h4 {
    margin: 0;
    font-size: var(--font-body);
    line-height: 1.4;
    font-weight: 600;
  }
  .saving-amount {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-top: var(--space-3);
    color: var(--color-primary);
    font-size: var(--font-value);
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .saving-amount > span {
    white-space: nowrap;
  }
  .saving-title {
    margin-top: var(--space-3);
    font-size: var(--font-small);
    font-weight: 600;
    line-height: 1.4;
  }
  .results-context {
    margin-bottom: var(--space-8);
  }
  .contact-band {
    border-block: var(--border-width) solid var(--color-line);
    background: var(--color-surface);
  }
  .contact-band-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }
  .contact-band p {
    margin-top: var(--space-3);
    color: var(--color-muted);
  }
  @media (min-width: 48rem) {
    ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-8);
    }
    .result-metric {
      display: block;
    }
    .result-value {
      margin-bottom: var(--space-3);
      font-size: var(--font-display);
    }
    .operational-results > li > p {
      margin-inline-start: 0;
    }
    .economic-results {
      gap: var(--space-4);
    }
    .economic-results > li {
      padding: var(--space-6);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) and
      (not (animation-trigger: --binding-impact play-once)) {
      .economic-impact {
        animation-name: impact-arrive;
        animation-duration: auto;
        animation-timing-function: var(--ease-out);
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 0% entry 80%;
      }
    }
    @supports (animation-trigger: --binding-impact play-once) and
      (timeline-trigger: --binding-impact view() entry 20% exit 100%) {
      .economic-impact {
        timeline-trigger: --binding-impact view() entry 20% exit 100%;
        animation: impact-arrive 560ms var(--ease-out) backwards;
        animation-trigger: --binding-impact play-once;
      }
    }
    .economic-impact:focus-within {
      transform: none !important;
    }
  }
  @keyframes impact-arrive {
    from {
      transform: translateY(14px);
    }
    to {
      transform: none;
    }
  }
</style>
