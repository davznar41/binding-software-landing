---
import Arrow from './Arrow.astro';

const steps = [
  {
    title: 'Inicia el registro',
    text: 'Antes de llegar o en el propio hotel.',
  },
  {
    title: 'Valida su identidad',
    text: 'Se verifica la documentación del huésped.',
  },
  {
    title: 'Firma y conexión',
    text: 'El registro llega al sistema de gestión.',
  },
  {
    title: 'Recepción preparada',
    text: 'Menos tareas, más tiempo para recibir.',
  },
];
---

<section id="proceso" class="section process" aria-labelledby="process-title">
  <div class="container">
    <div class="section-heading">
      <h2 id="process-title">Cuatro pasos. Una llegada más sencilla</h2>
      <p>El flujo se adapta a cada hotel.</p>
    </div>
    <ol role="list">
      {steps.map((step, index) => (
        <li>
          <span aria-hidden="true" class="step-number">
            {String(index + 1).padStart(2, '0')}
          </span>
          <div>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </div>
          {index < steps.length - 1 && (
            <span class="step-arrow" aria-hidden="true"><Arrow /></span>
          )}
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .process {
    --step-marker-size: 2.25rem;
    --process-gap: var(--space-8);
    background: var(--color-surface);
  }
  ol {
    display: grid;
    gap: var(--process-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    position: relative;
    display: grid;
    grid-template-columns: var(--step-marker-size) minmax(0, 1fr);
    align-content: start;
    gap: var(--space-4);
    padding: var(--space-4);
    border: var(--border-width) solid var(--color-line);
    border-radius: var(--radius-panel);
    background: var(--color-background);
  }
  .step-arrow {
    position: absolute;
    display: grid;
    place-items: center;
    inline-size: var(--space-6);
    block-size: var(--space-6);
    inset-inline-start: 50%;
    inset-block-start: calc(100% + var(--process-gap) / 2);
    translate: -50% -50%;
    rotate: 90deg;
    color: var(--color-primary);
  }
  .step-number {
    display: grid;
    place-items: center;
    width: var(--step-marker-size);
    height: var(--step-marker-size);
    border: var(--border-width) solid var(--color-line);
    border-radius: 50%;
    background: var(--color-primary-soft);
    color: var(--color-primary);
    font-size: var(--font-small);
    line-height: 1;
    font-weight: 600;
    letter-spacing: var(--tracking-heading);
    font-variant-numeric: tabular-nums;
  }
  h3 {
    font-size: var(--font-lead);
    line-height: 1.35;
  }
  li p {
    color: var(--color-muted);
    margin-top: var(--space-3);
    font-size: var(--font-small);
    max-width: 38ch;
  }
  @media (min-width: 48rem) {
    ol {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    li {
      grid-template-columns: minmax(0, 1fr);
    }
    .step-arrow {
      inset-inline-start: calc(100% + var(--process-gap) / 2);
      inset-block-start: 50%;
      rotate: 0deg;
    }
  }
  li:nth-child(2) {
    --step-delay: 100ms;
    --step-start: 10%;
    --step-end: 65%;
  }
  li:nth-child(3) {
    --step-delay: 200ms;
    --step-start: 20%;
    --step-end: 75%;
  }
  li:nth-child(4) {
    --step-delay: 300ms;
    --step-start: 30%;
    --step-end: 85%;
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) and
      (not (animation-trigger: --binding-process play-once)) {
      ol {
        view-timeline-name: --binding-process-view;
        view-timeline-axis: block;
      }
      .step-number {
        animation-name: step-arrive;
        animation-duration: auto;
        animation-timing-function: var(--ease-out);
        animation-fill-mode: both;
        animation-timeline: --binding-process-view;
        animation-range: entry var(--step-start, 0%) entry var(--step-end, 55%);
      }
    }
    @supports (animation-trigger: --binding-process play-once) and
      (timeline-trigger: --binding-process view() entry 25% exit 100%) {
      ol {
        timeline-trigger: --binding-process view() entry 25% exit 100%;
      }
      .step-number {
        animation: step-arrive 480ms var(--ease-out) var(--step-delay, 0ms)
          backwards;
        animation-trigger: --binding-process play-once;
      }
    }
  }
  @keyframes step-arrive {
    from {
      transform: translateY(12px) scale(0.94);
    }
    to {
      transform: none;
    }
  }
</style>
